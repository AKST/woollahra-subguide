{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "paths": {
      "@ui/*": ["./src/ui/*"],
      "@common/*": ["./src/common/*"],
      "@service/*": ["./src/service/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
