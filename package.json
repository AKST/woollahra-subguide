{
  "name": "speak-woollahra",
  "private": true,
  "description": "Helps people complete Woollahra Council's public forum registration form and download it as a PDF.",
  "type": "module",
  "scripts": {
    "start": "vite --port 8000",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "format": "prettier --write src tests *.json *.ts index.html README.md",
    "format:check": "prettier --check src tests *.json *.ts index.html README.md"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.50.0",
    "prettier": "^3.3.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
